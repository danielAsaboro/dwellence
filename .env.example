# Public browser configuration. Set only these VITE_ values in the Mini App host.
# Leave these unset for the recommended same-origin Docker deployment.
# Set them only when intentionally hosting the browser and API separately.
VITE_API_URL=https://your-dwellence-host.example
VITE_PROBE_URL=https://your-dwellence-host.example/probe

# Server-only configuration. Never expose this value in the browser bundle.
LOCATION_ENCRYPTION_KEY=replace-with-a-unique-secret-of-at-least-24-characters
DATABASE_PATH=./data/location-evidence.sqlite
# Same-origin requests need no CORS entry. Comma-separate explicit browser origins when split-hosting.
ALLOWED_ORIGINS=
NIMIQ_RPC_URL=https://your-nimiq-testnet-rpc.example
PORT=8787
STATIC_DIRECTORY=./dist
